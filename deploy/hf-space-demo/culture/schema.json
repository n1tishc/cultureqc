{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "cultureQC Record",
  "definitions": {
    "checkState": {
      "type": "object",
      "required": ["requirement", "status"],
      "properties": {
        "requirement": {"enum": ["required", "optional", "not_applicable"]},
        "status": {"enum": ["passed", "failed", "unavailable", "not_applicable"]}
      },
      "if": {"properties": {"requirement": {"const": "not_applicable"}}},
      "then": {"properties": {"status": {"const": "not_applicable"}}},
      "else": {"properties": {"status": {"enum": ["passed", "failed", "unavailable"]}}},
      "additionalProperties": false
    },
    "timingState": {
      "type": "object",
      "required": ["hours", "interval_h", "status"],
      "properties": {
        "hours": {"type": ["number", "null"], "minimum": 0},
        "interval_h": {"type": "number", "minimum": 0},
        "status": {"enum": ["unknown", "held", "elapsed"]}
      },
      "if": {"properties": {"hours": {"type": "null"}}},
      "then": {"properties": {"status": {"const": "unknown"}}},
      "else": {"properties": {"status": {"enum": ["held", "elapsed"]}}},
      "additionalProperties": false
    }
  },
  "description": "One chain, three record types: a reading per analysed image, a review per person's decision on a reading (linked by hash; the reading is never edited), and a change per change-controlled update. Numbers come from models; the rules decide; people review.",
  "oneOf": [
    {
      "type": "object",
      "title": "reading",
      "required": [
        "record_id",
        "prev_record_hash",
        "schema_version",
        "flask_id",
        "cell_line",
        "captured_at",
        "analysed_at",
        "image_ref",
        "image_hash",
        "confluency_pct",
        "confluency_confidence",
        "confluency_method",
        "qc_flag",
        "qc_confidence",
        "recommended_action",
        "action_reason",
        "decided_by",
        "model_versions",
        "record_type",
        "confluency_profile",
        "confluency_interval",
        "quality_gate",
        "recovery_request"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "description": "UUID v4 for this record"
        },
        "prev_record_hash": {
          "type": "string",
          "description": "SHA-256 of the previous record's canonical JSON. Genesis record uses 64 zeros."
        },
        "schema_version": {
          "type": "string",
          "enum": [
            "0.4",
            "0.5",
            "0.6",
            "0.7",
            "0.8"
          ],
          "description": "0.4: reading/review/change records. 0.5: model check. 0.6: replay inputs and consumed configuration. 0.7: explicit host-managed activation. 0.8: controlled decoding and original-byte/decoded-pixel provenance."
        },
        "record_hash": {
          "type": "string",
          "description": "SHA-256 of this record's canonical JSON (sorted keys, compact, ASCII) without record_hash itself. Added by culture/records.py::RecordWriter.append."
        },
        "flask_id": {
          "type": "string",
          "description": "Vessel / labware ID, from the host platform"
        },
        "cell_line": {
          "type": "string"
        },
        "protocol_stage": {
          "type": [
            "string",
            "null"
          ],
          "description": "Protocol step that took the image, from the host platform"
        },
        "captured_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "capture_time_source": {"enum": ["host", "unknown"]},
        "analysis_started_at": {"type": "string", "format": "date-time"},
        "analysis_completed_at": {"type": "string", "format": "date-time"},
        "map_provenance": {
          "type": "object",
          "required": ["status", "representation"],
          "properties": {
            "status": {"enum": ["captured", "unavailable"]},
            "representation": {"const": "culture.cache.downsample_probmap/x1000-int16-v1"}
          },
          "additionalProperties": false
        },
        "decision_inputs": {
          "type": "object",
          "required": ["policy", "sha256", "values"],
          "properties": {
            "policy": {"const": "rules_v0.7"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "values": {
              "type": "object",
              "required": ["confluency_pct", "confluency_confidence", "qc_flag", "qc_confidence", "line_config", "hours_since_passage", "hours_since_feed", "anomaly_flag", "band_pp", "quality_passed", "quality_reasons", "profile", "setup_context", "check_policy"],
              "properties": {
                "confluency_pct": {"type": "number", "minimum": 0, "maximum": 100},
                "confluency_confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "qc_flag": {"enum": [null, "normal", "contamination_suspected", "detachment", "image_quality"]},
                "qc_confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
                "line_config": {"type": "object", "required": ["cell_line", "target_confluency", "min_hours_since_passage", "feed_interval_h", "qc_review_threshold", "confluency_confidence_floor"]},
                "hours_since_passage": {"type": ["number", "null"], "minimum": 0},
                "hours_since_feed": {"type": ["number", "null"], "minimum": 0},
                "anomaly_flag": {"type": ["boolean", "null"]},
                "band_pp": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
                "quality_passed": {"type": ["boolean", "null"]},
                "quality_reasons": {"type": ["array", "null"], "items": {"type": "string"}},
                "profile": {"type": "object", "required": ["id", "cutoff", "band_pp", "status", "description", "quality", "entry"]},
                "setup_context": {"type": "object", "required": ["setup_id", "cell_line", "model_sha256"]},
                "check_policy": {"type": "object", "required": ["qc", "anomaly"], "additionalProperties": {"enum": ["required", "optional", "not_applicable"]}}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "config_snapshot": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_path", "status", "sha256", "text"],
            "properties": {
              "source_path": {"type": "string", "minLength": 1},
              "status": {"enum": ["read", "missing"]},
              "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "text": {"type": ["string", "null"]}
            },
            "if": {"properties": {"status": {"const": "read"}}},
            "then": {"properties": {"text": {"type": "string"}, "sha256": {"type": "string"}}},
            "else": {"properties": {"text": {"type": "null"}, "sha256": {"type": "null"}}},
            "additionalProperties": false
          }
        },
        "analysed_at": {
          "type": "string",
          "format": "date-time"
        },
        "image_ref": {
          "type": "string",
          "description": "Path or URI to the source image"
        },
        "image_hash": {
          "type": "string",
          "description": "SHA-256 of the raw image bytes"
        },
        "pixel_size_um": {
          "type": [
            "number",
            "null"
          ]
        },
        "confluency_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "confluency_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "1 − boundary ambiguity. Recorded; decides nothing since rules_v0.5 (it tracks density, not the reading's error: results/confidence_vs_error.md)"
        },
        "confluency_method": {
          "type": "string",
          "enum": [
            "probmap",
            "instance",
            "threshold"
          ],
          "description": "What culture/seg.py writes: Cellpose-SAM probability map (the default), its instance masks, or the threshold baseline."
        },
        "confluency_map_hash": {
          "type": [
            "string",
            "null"
          ],
          "description": "SHA-256 of the Cellpose-SAM cell-probability map the confluency was counted from, at 1/4 resolution as int16 logits x 1000 (culture.cache.probmap_sha256); null when the record has no map"
        },
        "qc_flag": {
          "type": "string",
          "enum": [
            "normal",
            "contamination_suspected",
            "detachment",
            "image_quality"
          ]
        },
        "qc_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "qc_severity": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "early",
            "mid",
            "late",
            null
          ]
        },
        "qc_evidence_bbox": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer"
          },
          "minItems": 4,
          "maxItems": 4,
          "description": "[x, y, w, h] in tile coordinates"
        },
        "qc_rationale": {
          "type": [
            "string",
            "null"
          ],
          "description": "<=2 sentences, references image regions"
        },
        "qc_calibrated": {
          "type": "boolean",
          "description": "qc_confidence is temperature-scaled (configs/calibration.yaml)"
        },
        "qc_used_in_decision": {
          "type": "boolean",
          "description": "false while the classifier is demoted (configs/qc.yaml): recorded, not used by the rules"
        },
        "anomaly_status": {
          "type": "string",
          "enum": [
            "ok",
            "unavailable"
          ],
          "description": "per-image anomaly check (culture/anomaly.py); unavailable when the banks are missing or unverified"
        },
        "anomaly_score": {
          "type": [
            "number",
            "null"
          ]
        },
        "anomaly_z": {
          "type": [
            "number",
            "null"
          ]
        },
        "anomaly_bin": {
          "type": [
            "string",
            "null"
          ]
        },
        "anomaly_threshold": {
          "type": [
            "number",
            "null"
          ]
        },
        "anomaly_flag": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "anomaly_bank_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "anomaly_used_in_decision": {
          "type": "boolean",
          "description": "true when the anomaly check ran and its flag was an input to the rules (since rules_v0.3: a flag turns passage into human_review; continue and feed are unchanged); false when the check was unavailable"
        },
        "growth_trend": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "rising",
            "flat",
            "falling",
            "unknown",
            null
          ]
        },
        "eta_to_target_hours": {
          "type": [
            "number",
            "null"
          ]
        },
        "recommended_action": {
          "type": "string",
          "enum": [
            "passage",
            "feed",
            "continue",
            "human_review",
            "reimage"
          ],
          "description": "rules_v0.5 added reimage. rules_v0.4 renamed hold to continue (label only)."
        },
        "action_reason": {
          "type": "string"
        },
        "decided_by": {
          "type": "string"
        },
        "model_versions": {
          "type": "object",
          "properties": {
            "seg": {
              "type": "string"
            },
            "qc": {
              "type": "string"
            },
            "dino": {
              "type": "string"
            },
            "vlm": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "model_weights_hash": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": "SHA-256 of each model's weights file, keyed like model_versions; null where the file was not found"
        },
        "preprocessing": {
          "type": "object",
          "required": ["policy", "source_format", "source_mode", "source_dtype", "source_shape", "source_sha256", "frame_count", "orientation", "transform", "decoder_version", "output_dtype", "output_shape", "output_sha256", "sha256"],
          "properties": {
            "policy": {"const": "uint8-single-frame-v1"},
            "source_format": {"enum": ["PNG", "JPEG", "TIFF", "BMP", "WEBP"]},
            "source_mode": {"enum": ["L", "RGB"]},
            "source_dtype": {"const": "uint8"},
            "source_shape": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "integer", "minimum": 1, "maximum": 8192}},
            "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "frame_count": {"const": 1},
            "orientation": {"const": 1},
            "transform": {"enum": ["identity", "opencv-grayscale"]},
            "decoder_version": {"type": "string", "minLength": 1},
            "output_dtype": {"const": "uint8"},
            "output_shape": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1, "maximum": 8192}},
            "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        },
        "configuration_activation": {
          "type": "object",
          "required": ["mode", "local_enforcement", "host_approval_ref", "configuration_sha256"],
          "properties": {
            "mode": {"const": "host_managed"},
            "local_enforcement": {"const": false},
            "host_approval_ref": {"type": "null"},
            "configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "additionalProperties": false
        },
        "config_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Schema 0.6: consumed YAML snapshots keyed by effective source path, not an after-inference file inventory. Model approvals are identified by model_check.approvals_head. Earlier schemas used file names."
        },
        "record_type": {
          "const": "reading"
        },
        "lineage": {
          "type": [
            "object",
            "null"
          ],
          "description": "From the host platform",
          "properties": {
            "passage_number": {
              "type": [
                "integer",
                "null"
              ]
            },
            "parent_flask_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "imager_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "The instrument that took the image, from the host platform"
        },
        "fov": {
          "type": [
            "object",
            "null"
          ],
          "description": "Field of view within the vessel",
          "properties": {
            "index": {
              "type": [
                "integer",
                "null"
              ]
            },
            "x_mm": {
              "type": [
                "number",
                "null"
              ]
            },
            "y_mm": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "environment": {
          "type": [
            "object",
            "null"
          ],
          "description": "Snapshot supplied by the host platform at capture (e.g. temperature, CO2); stored as given, not used by cultureQC"
        },
        "decision": {
          "type": "object",
          "required": ["reason_code", "mode", "host_actionable", "checks", "timing", "warnings"],
          "properties": {
            "reason_code": {"enum": ["qc_flagged", "quality_failed", "qc_incomplete", "passage_time_unknown", "measurement_uncalibrated", "anomaly_flagged", "passage_scope_unsupported", "required_check_unavailable", "passage_candidate", "target_within_error_band", "feed_due", "passage_interval_hold", "monitor_advisory"]},
            "mode": {"const": "advisory"},
            "host_actionable": {"const": false},
            "checks": {
              "type": "object",
              "required": ["quality", "qc", "anomaly"],
              "properties": {
                "quality": {"allOf": [{"$ref": "#/definitions/checkState"}, {"properties": {"requirement": {"const": "required"}}}]},
                "qc": {"$ref": "#/definitions/checkState"},
                "anomaly": {"$ref": "#/definitions/checkState"}
              },
              "additionalProperties": false
            },
            "timing": {
              "type": "object",
              "required": ["passage", "feed"],
              "properties": {"passage": {"$ref": "#/definitions/timingState"}, "feed": {"$ref": "#/definitions/timingState"}},
              "additionalProperties": false
            },
            "warnings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          },
          "additionalProperties": false,
          "description": "rules_v0.7 advisory policy evaluation; no recommended action is a host execution authorization."
        },
        "passage_eligibility": {
          "type": "object",
          "required": ["eligible", "reason", "setup_id", "cell_line", "model_sha256", "reading_pct", "target_pct"],
          "properties": {
            "eligible": {"type": "boolean"},
            "reason": {"type": "string", "minLength": 1},
            "setup_id": {"type": ["string", "null"]},
            "cell_line": {"type": ["string", "null"]},
            "model_sha256": {"type": ["string", "null"]},
            "reading_pct": {"type": "number", "minimum": 0, "maximum": 100},
            "target_pct": {"type": "number", "minimum": 0, "maximum": 100}
          },
          "additionalProperties": false,
          "description": "rules_v0.6 evaluated passage scope; eligibility is not itself a passage command. Historical rules_v0.5 records lack this field."
        },
        "confluency_profile": {
          "type": "object",
          "required": [
            "id",
            "sha256",
            "status",
            "cutoff",
            "band_pp"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "status": {
              "enum": [
                "validated",
                "failed",
                "in_domain_check",
                "uncalibrated"
              ]
            },
            "cutoff": {
              "type": "number"
            },
            "band_pp": {
              "type": [
                "number",
                "null"
              ]
            },
            "measurement_calibrated": {"type": "boolean"},
            "validated_scope": {
              "type": ["object", "null"],
              "required": ["setup_id", "cell_line", "model_sha256", "reading_range_pct", "target_range_pct"],
              "properties": {
                "setup_id": {"type": "string", "minLength": 1},
                "cell_line": {"type": "string", "minLength": 1},
                "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "reading_range_pct": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 100}},
                "target_range_pct": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0, "maximum": 100}}
              },
              "additionalProperties": false
            },
            "action_eligibility": {
              "type": "object",
              "required": ["status", "reason"],
              "properties": {
                "status": {"enum": ["eligible", "unsupported"]},
                "reason": {"type": "string", "minLength": 1},
                "approval_ref": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "description": "Measurement calibration is distinct from validated decision scope and passage eligibility. Legacy status validated refers only to measurement criteria."
        },
        "confluency_interval": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "Reading ± the profile's 90% error band, clipped to 0-100; null for an uncalibrated setup"
        },
        "anomaly_bin_confluency_pct": {
          "type": [
            "number",
            "null"
          ],
          "description": "Confluency at Cellpose's default cutoff, which picks the anomaly check's density bin (its banks and thresholds were calibrated at that cutoff)"
        },
        "quality_gate": {
          "type": [
            "object",
            "null"
          ],
          "description": "null: no quality gate is calibrated for this imaging setup",
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "thresholds": {
              "type": "string"
            },
            "blur": {
              "type": "number"
            },
            "mean_intensity": {
              "type": "number"
            },
            "uniformity": {
              "type": "number"
            }
          },
          "required": [
            "passed",
            "reasons",
            "thresholds"
          ],
          "additionalProperties": false
        },
        "recovery_request": {
          "type": [
            "object",
            "null"
          ],
          "description": "Machine-readable request to the host scheduler",
          "properties": {
            "action": {
              "const": "reimage"
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "action",
            "reasons"
          ],
          "additionalProperties": false
        },
        "model_check": {
          "type": "object",
          "required": [
            "id",
            "status",
            "sha256",
            "approved_sha256",
            "approvals_head"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "status": {
              "enum": [
                "match",
                "mismatch",
                "missing_file",
                "not_approved",
                "approvals_unavailable"
              ]
            },
            "sha256": {
              "type": [
                "string",
                "null"
              ]
            },
            "approved_sha256": {
              "type": [
                "string",
                "null"
              ]
            },
            "approvals_head": {
              "type": [
                "string",
                "null"
              ],
              "description": "record_hash of the approvals log's last record when the check ran"
            }
          },
          "additionalProperties": false,
          "description": "The shipped model's weights checked against the latest approved change record for it in configs/approved_changes.jsonl (culture/approvals.py). A reading exists only when the status is match: on any other status the model does not read."
        },
        "finetuned_reading": {
          "type": [
            "object",
            "null"
          ],
          "description": "A fine-tuned model's reading of the same image (culture/finetuned.py), beside the shipped one. Never used in the decision. If its weights do not match the approved change record, confluency_pct is null and check gives the status and reason.",
          "required": [
            "id",
            "base",
            "status",
            "cutoff",
            "band_pp",
            "check",
            "reason",
            "confluency_pct",
            "used_in_decision"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "base": {
              "type": "string"
            },
            "status": {
              "enum": [
                "not_validated"
              ]
            },
            "cutoff": {
              "type": "number"
            },
            "band_pp": {
              "type": "null"
            },
            "check": {
              "type": "object",
              "required": [
                "id",
                "status",
                "sha256",
                "approved_sha256",
                "approvals_head"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "match",
                    "mismatch",
                    "missing_file",
                    "not_approved",
                    "approvals_unavailable"
                  ]
                },
                "sha256": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "approved_sha256": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "approvals_head": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "record_hash of the approvals log's last record when the check ran"
                }
              },
              "additionalProperties": false
            },
            "reason": {
              "type": "string"
            },
            "confluency_pct": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "used_in_decision": {
              "const": false
            }
          },
          "additionalProperties": false
