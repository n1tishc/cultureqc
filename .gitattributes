# The Space carries mirrored copies of culture/ and config/, written by
# deploy/sync_space.py. Counting them doubles the pipeline's weight in the
# language stats and fills diffs with changes nobody made by hand.
deploy/hf-space/culture/** linguist-generated=true
deploy/hf-space/config/**  linguist-generated=true

# Generated by site/assets/build_data.py from real pipeline output.
site/src/data.json linguist-generated=true

# Lockfiles are machine-written; GitHub counts them as source otherwise.
site/package-lock.json linguist-generated=true

# Binary assets, so git never tries to diff or normalise them.
*.woff2 binary
*.png   binary
*.webp  binary
*.tif   binary
