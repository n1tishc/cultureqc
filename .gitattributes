# GitHub's language bar reported this repo as ~87% HTML. That was one file:
# site/index.html, which is not written by hand — site/src/assemble.py builds it
# from template.html and inlines the fonts, images and data as base64. Marking it
# generated keeps it out of the language stats (and collapses it in diffs), so the
# bar reflects the code someone actually maintains.
site/index.html linguist-generated=true

# Likewise generated: the Space carries mirrored copies of culture/ and config/,
# written by deploy/sync_space.py. Counting them doubles the pipeline's weight.
deploy/hf-space/culture/** linguist-generated=true
deploy/hf-space/config/**  linguist-generated=true

# Binary assets, so git never tries to diff or normalise them.
*.woff2 binary
*.png   binary
*.webp  binary
*.tif   binary
