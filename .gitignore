# ── Python ──
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# ── Node / Vite (the frontend lives in site/) ──
node_modules/
site/dist/
site/dist-*/
*.local

# ── OS ──
.DS_Store

# ── Training data (regenerable; see docs/DATA.md) ──
# Nothing under data/ is source. `data/sources/` is downloaded from Zenodo and
# `data/sprites/` is derived from it by scripts/extract_sprites.py, so both are
# reproducible from two commands and neither belongs in git — together they were
# 1.8 GB of downloads and 15 MB of committed PNGs.
data/
bacteria_sprites.zip

# ── Runtime output ──
demo/uploads/
demo/events_web.jsonl
events*.jsonl
# ...except this one, which is not runtime output: it is the nine real records
# the page displays and re-verifies, and site/assets/build_data.py reads it.
!site/assets/pipeline-output/events.jsonl

# ── Local tool state ──
# Kept on disk, out of the repo: these are editor/agent scratch, not project source.
.claude/
.codex/
.impeccable/
